#!/usr/bin/env python3
import json
import pathlib
import shlex
import sys


HOME = pathlib.Path.home()
STATUS_COMMAND = HOME / "bin" / "agent-turn-ended-status"
MANAGED_COMMANDS = ("agent-turn-ended-status", "codex-turn-ended-notify")


def read_json(path, default):
    if not path.exists():
        return default
    try:
        with path.open(encoding="utf-8") as file:
            return json.load(file)
    except json.JSONDecodeError as exc:
        print(f"sync-agent-status-hooks: invalid JSON in {path}: {exc}", file=sys.stderr)
        raise SystemExit(1)


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=False) + "\n", encoding="utf-8")


def command(agent):
    return f"{shlex.quote(str(STATUS_COMMAND))} {shlex.quote(agent)}"


def is_managed_hook(hook):
    if not isinstance(hook, dict):
        return False
    value = hook.get("command")
    return isinstance(value, str) and any(name in value for name in MANAGED_COMMANDS)


def remove_nested_hooks(hooks):
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        remaining_groups = []
        for group in groups:
            if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
                remaining_groups.append(group)
                continue
            remaining = [hook for hook in group["hooks"] if not is_managed_hook(hook)]
            if remaining:
                updated = dict(group)
                updated["hooks"] = remaining
                remaining_groups.append(updated)
        if remaining_groups:
            hooks[event] = remaining_groups
        else:
            hooks.pop(event, None)


def remove_flat_hooks(hooks):
    for event in list(hooks):
        entries = hooks[event]
        if not isinstance(entries, list):
            continue
        remaining = [hook for hook in entries if not is_managed_hook(hook)]
        if remaining:
            hooks[event] = remaining
        else:
            hooks.pop(event, None)


def add_nested_stop(hooks, agent):
    hooks.setdefault("Stop", []).append(
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command(agent),
                    "timeout": 10,
                }
            ]
        }
    )


def remove_legacy_codex_notify():
    path = HOME / ".codex" / "config.toml"
    if not path.exists():
        return
    lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
    output = []
    index = 0
    in_table = False
    while index < len(lines):
        line = lines[index]
        stripped = line.lstrip()
        if stripped.startswith("["):
            in_table = True
        if not in_table and stripped.startswith("notify") and stripped.split("=", 1)[0].strip() == "notify":
            block = [line]
            index += 1
            while index < len(lines) and "".join(block).count("[") > "".join(block).count("]"):
                block.append(lines[index])
                index += 1
            if any(name in "".join(block) for name in MANAGED_COMMANDS):
                continue
            output.extend(block)
            continue
        output.append(line)
        index += 1
    path.write_text("".join(output), encoding="utf-8")


def sync_claude():
    path = HOME / ".claude" / "settings.json"
    data = read_json(path, {})
    if not isinstance(data, dict):
        raise SystemExit(f"sync-agent-status-hooks: expected object in {path}")
    data["agentPushNotifEnabled"] = False
    hooks = data.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise SystemExit(f"sync-agent-status-hooks: expected hooks object in {path}")
    remove_nested_hooks(hooks)
    add_nested_stop(hooks, "claude")
    write_json(path, data)


def sync_cursor():
    path = HOME / ".cursor" / "hooks.json"
    data = read_json(path, {"version": 1})
    if not isinstance(data, dict):
        raise SystemExit(f"sync-agent-status-hooks: expected object in {path}")
    data.setdefault("version", 1)
    hooks = data.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise SystemExit(f"sync-agent-status-hooks: expected hooks object in {path}")
    remove_flat_hooks(hooks)
    hooks.setdefault("stop", []).append({"command": command("cursor")})
    write_json(path, data)


def sync_codex():
    remove_legacy_codex_notify()
    path = HOME / ".codex" / "hooks.json"
    data = read_json(path, {})
    if not isinstance(data, dict):
        raise SystemExit(f"sync-agent-status-hooks: expected object in {path}")
    hooks = data.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise SystemExit(f"sync-agent-status-hooks: expected hooks object in {path}")
    remove_nested_hooks(hooks)
    add_nested_stop(hooks, "codex")
    write_json(path, data)


def main():
    sync_claude()
    sync_cursor()
    sync_codex()
    print("sync-agent-status-hooks: updated status-only completion hooks")


if __name__ == "__main__":
    main()
