#!/usr/bin/env python3
import json
import pathlib
import shlex
import sys


HOME = pathlib.Path.home()
STATUS_COMMAND = HOME / "bin" / "agent-turn-ended-status"


def read_json(path, default):
    if not path.exists():
        return default
    try:
        with path.open(encoding="utf-8") as file:
            return json.load(file)
    except json.JSONDecodeError as exc:
        print(f"sync-agent-status-hooks: invalid JSON in {path}: {exc}", file=sys.stderr)
        raise SystemExit(1)


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=False) + "\n", encoding="utf-8")


def command(agent):
    return f"{shlex.quote(str(STATUS_COMMAND))} {shlex.quote(agent)}"


def is_managed_hook(hook, agent):
    if not isinstance(hook, dict):
        return False
    value = hook.get("command")
    if not isinstance(value, str):
        return False
    try:
        args = shlex.split(value)
    except ValueError:
        return False
    return len(args) == 2 and pathlib.Path(args[0]).name == STATUS_COMMAND.name and args[1] == agent


def remove_nested_hooks(hooks, agent):
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        remaining_groups = []
        for group in groups:
            if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
                remaining_groups.append(group)
                continue
            remaining = [hook for hook in group["hooks"] if not is_managed_hook(hook, agent)]
            if remaining:
                updated = dict(group)
                updated["hooks"] = remaining
                remaining_groups.append(updated)
        if remaining_groups:
            hooks[event] = remaining_groups
        else:
            hooks.pop(event, None)


def remove_flat_hooks(hooks, agent):
    for event in list(hooks):
        entries = hooks[event]
        if not isinstance(entries, list):
            continue
        remaining = [hook for hook in entries if not is_managed_hook(hook, agent)]
        if remaining:
            hooks[event] = remaining
        else:
            hooks.pop(event, None)


def sync(agent, spec):
    path = HOME / spec["path"]
    enabled = spec.get("enabled", True)
    if not enabled and not path.exists():
        return
    data = read_json(path, {})
    if not isinstance(data, dict):
        raise SystemExit(f"sync-agent-status-hooks: expected object in {path}")
    for key, value in spec.get("defaults", {}).items():
        data.setdefault(key, value)
    data.update(spec.get("settings", {}))
    hooks = data.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise SystemExit(f"sync-agent-status-hooks: expected hooks object in {path}")
    previous_hooks = hooks.copy()
    entry = {"command": command(agent)}
    if spec.get("nested"):
        remove_nested_hooks(hooks, agent)
        entry = {"hooks": [{"type": "command", **entry, "timeout": 10}]}
    else:
        remove_flat_hooks(hooks, agent)
    if enabled:
        hooks.setdefault(spec["event"], []).append(entry)
    if enabled or hooks != previous_hooks:
        write_json(path, data)


def main():
    bin_dir = pathlib.Path(__file__).resolve().parent
    installed = bin_dir / "agent-status-hooks"
    source = bin_dir.parent / "nvim/lua/luanphan/agents/plugins"
    if installed.is_dir():
        definitions = [(path.stem, path) for path in sorted(installed.glob("*.json"))]
    else:
        definitions = [(path.parent.name, path) for path in sorted(source.glob("*/status-hook.json"))]
    if not definitions:
        raise SystemExit("sync-agent-status-hooks: no hook definitions found")
    for agent, path in definitions:
        spec = read_json(path, {})
        marker = STATUS_COMMAND.parent / "agent-status-hooks" / f"{agent}.disabled"
        if spec.get("enabled", True):
            marker.unlink(missing_ok=True)
        else:
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.touch()
        sync(agent, spec)
    print("sync-agent-status-hooks: updated status-only completion hooks")


if __name__ == "__main__":
    main()
