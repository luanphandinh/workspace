#!/bin/sh
set -eu

usage() {
	printf 'Usage: neovide-server [port] [nvim-args...]\n' >&2
}

case "${1:-}" in
	-h|--help)
		usage
		exit 0
		;;
esac

port="${1:-6666}"
if [ "$#" -gt 0 ]; then
	shift
fi

case "$port" in
	""|*[!0-9]*)
		usage
		exit 2
		;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65533 ]; then
	printf 'neovide-server: port must be between 1 and 65533\n' >&2
	exit 2
fi

command -v nvim >/dev/null 2>&1 || {
	printf 'neovide-server: nvim is not installed\n' >&2
	exit 1
}

export NEOVIDE_MARKDOWN_PREVIEW_PORT=$((port + 1))
export NEOVIDE_REMOTE_OPEN_PORT=$((port + 2))

exec nvim --headless --listen "127.0.0.1:$port" "$@"
