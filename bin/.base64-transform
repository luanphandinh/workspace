#!/bin/sh
set -eu

die() {
	printf 'error: %s\n' "$1" >&2
	exit 1
}

usage() {
	case "$mode" in
		decode)
			cat <<'EOF'
Usage: base64decode [--] [value]

Decode a standard Base64 value.
With no value, input is read from the system clipboard.
EOF
			;;
		encode)
			cat <<'EOF'
Usage: base64encode [--] [value]

Encode a value as standard Base64.
With no value, input is read from the system clipboard.
EOF
			;;
	esac
}

read_clipboard() {
	if command -v pbpaste >/dev/null 2>&1; then
		pbpaste
		return
	fi
	if command -v wl-paste >/dev/null 2>&1; then
		wl-paste --no-newline
		return
	fi
	if command -v xclip >/dev/null 2>&1; then
		xclip -selection clipboard -o
		return
	fi
	if command -v xsel >/dev/null 2>&1; then
		xsel --clipboard --output
		return
	fi
	if command -v powershell.exe >/dev/null 2>&1; then
		powershell.exe -NoProfile -Command 'Get-Clipboard -Raw'
		return
	fi
	die "no supported clipboard command found"
}

[ "$#" -ge 1 ] || die "missing transform mode"
mode=$1
shift

case "$mode" in
	decode|encode) ;;
	*) die "unknown transform mode: $mode" ;;
esac

case "${1:-}" in
	-h|--help)
		usage
		exit 0
		;;
	--)
		shift
		;;
esac

[ "$#" -le 1 ] || die "expected one quoted value"
command -v base64 >/dev/null 2>&1 || die "base64 is required"

tmp=$(mktemp "${TMPDIR:-/tmp}/base64-transform.XXXXXX")
clean=$(mktemp "${TMPDIR:-/tmp}/base64-transform-clean.XXXXXX")
trap 'rm -f "$tmp" "$clean"' EXIT HUP INT TERM
if [ "$#" -eq 1 ]; then
	printf '%s' "$1" > "$tmp"
else
	read_clipboard > "$tmp"
fi

case "$mode" in
	encode)
		base64 < "$tmp" | tr -d '\n'
		;;
	decode)
		tr -d '[:space:]' < "$tmp" > "$clean"
		if [ -s "$clean" ] && ! grep -Eq '^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$' "$clean"; then
			die "input is not valid standard Base64"
		fi
		case "$(uname -s)" in
			Darwin) base64 -D < "$clean" ;;
			*) base64 --decode < "$clean" ;;
		esac
		;;
esac
