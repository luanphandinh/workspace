#!/bin/sh
set -eu

usage() {
	printf '%s\n' \
		'Usage: neovide-client [options] <ssh-host>[:port] [neovide-args...]' \
		'' \
		'Options:' \
		'  -p, --port PORT    Remote Neovim base port (default: 6666)' \
		'      --trace        Print every shell command as it executes' \
		'      --ssh-verbose  Stream verbose SSH diagnostics' \
		'  -h, --help         Show this help'
}

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
	color_info=$(printf '\033[34m')
	color_success=$(printf '\033[32m')
	color_warning=$(printf '\033[33m')
	color_error=$(printf '\033[31m')
	color_command=$(printf '\033[35m')
	color_reset=$(printf '\033[0m')
else
	color_info=
	color_success=
	color_warning=
	color_error=
	color_command=
	color_reset=
fi

log() {
	level=$1
	shift
	timestamp=$(date '+%Y-%m-%d %H:%M:%S')
	case "$level" in
		Info) color=$color_info ;;
		Success) color=$color_success ;;
		Warning) color=$color_warning ;;
		Error) color=$color_error ;;
		Command) color=$color_command ;;
		*) color= ;;
	esac
	printf '[%s] %s[%s]%s neovide-client: %s\n' "$timestamp" "$color" "$level" "$color_reset" "$*" >&2
}

log_command() {
	timestamp=$(date '+%Y-%m-%d %H:%M:%S')
	printf '[%s] %s[Command]%s neovide-client:' "$timestamp" "$color_command" "$color_reset" >&2
	for argument in "$@"; do
		printf ' [%s]' "$argument" >&2
	done
	printf '\n' >&2
}

port=6666
port_set=0
trace=0
ssh_verbose=
target=
while [ "$#" -gt 0 ]; do
	case "$1" in
		-p|--port)
			[ "$#" -gt 1 ] || { log Error "$1 requires a value"; exit 2; }
			port=$2
			port_set=1
			shift 2
			;;
		--port=*) port=${1#*=}; port_set=1; shift ;;
		--trace) trace=1; shift ;;
		--ssh-verbose) ssh_verbose=-v; shift ;;
		-h|--help) usage; exit 0 ;;
		--)
			shift
			[ "$#" -gt 0 ] || { log Error 'missing SSH host after --'; exit 2; }
			target=$1
			shift
			break
			;;
		-*) log Error "unknown option: $1"; exit 2 ;;
		*) target=$1; shift; break ;;
	esac
done

[ -n "$target" ] || {
	log Error 'missing SSH host'
	usage
	exit 2
}

if [ "$trace" -eq 1 ]; then
	set -x
fi

case "$target" in
	:*|-*) log Error "invalid SSH host: $target"; exit 2 ;;
	*:*)
		ssh_host=${target%:*}
		[ "$port_set" -eq 0 ] || { log Error 'port specified both in the target and with --port'; exit 2; }
		port=${target##*:}
		;;
	*) ssh_host=$target ;;
esac

case "$port" in
	""|*[!0-9]*) log Error 'port must be numeric'; exit 2 ;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65534 ]; then
	log Error 'port must be between 1 and 65534'
	exit 2
fi

for dependency in neovide python3 ssh; do
	command -v "$dependency" >/dev/null 2>&1 || {
		log Error "$dependency is not installed"
		exit 1
	}
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bridge=$script_dir/.tunnel-bridge
[ -x "$bridge" ] || {
	log Error "missing $bridge"
	exit 1
}

preview_port=$((port + 1))
client_tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/neovide-client.XXXXXX")
control_socket=$client_tmp_dir/ssh-control
local_nvim_port=$($bridge allocate --count 1)
tunnel_started=0

cleanup() {
	if [ "$tunnel_started" -eq 1 ]; then
		log Info "stopping SSH tunnel to $ssh_host"
		ssh -S "$control_socket" -O exit "$ssh_host" >/dev/null 2>&1 || true
	fi
	rm -rf "$client_tmp_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

log Info "remote ports: Neovim $port, Markdown preview $preview_port"
log Info "local Neovim port: $local_nvim_port"
log Info "creating SSH tunnel to $ssh_host"
log_command ssh ${ssh_verbose:+"$ssh_verbose"} -M -S "$control_socket" -o ControlPersist=no -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -fN -L "127.0.0.1:$local_nvim_port:127.0.0.1:$port" "$ssh_host"
ssh -M -S "$control_socket" \
	${ssh_verbose:+"$ssh_verbose"} \
	-o ControlPersist=no \
	-o ExitOnForwardFailure=yes \
	-o ServerAliveInterval=15 \
	-o ServerAliveCountMax=3 \
	-fN \
	-L "127.0.0.1:$local_nvim_port:127.0.0.1:$port" \
	"$ssh_host"
tunnel_started=1
log Success 'Neovim SSH tunnel established'

log Info 'waiting for remote Neovim'
"$bridge" wait --port "$local_nvim_port" --timeout "${NEOVIDE_CONNECT_TIMEOUT:-15}"
log Success 'remote Neovim is reachable'

if ssh -S "$control_socket" "$ssh_host" '~/bin/tunnel _ping-incoming' >/dev/null 2>&1; then
	log Success 'workspace tunnel is available for URLs and images'
else
	log Warning "workspace tunnel is unavailable; run 'tunnel connect $ssh_host' locally"
fi

log Info 'launching Neovide'
log_command neovide --no-fork --server "127.0.0.1:$local_nvim_port" "$@"
neovide_status=0
neovide --no-fork --server "127.0.0.1:$local_nvim_port" "$@" || neovide_status=$?
if [ "$neovide_status" -eq 0 ]; then
	log Success "Neovide exited with status $neovide_status"
else
	log Error "Neovide exited with status $neovide_status"
fi
exit "$neovide_status"
