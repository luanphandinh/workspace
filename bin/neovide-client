#!/bin/sh
set -eu

usage() {
	printf '%s\n' \
		'Usage: neovide-client [options] <ssh-host>[:port] [neovide-args...]' \
		'' \
		'Options:' \
		'  -p, --port PORT  Remote Neovim base port (default: 6666)' \
		'      --trace      Print every shell command as it executes' \
		'      --ssh-verbose  Stream verbose SSH diagnostics' \
		'  -h, --help       Show this help'
}

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
	color_info=$(printf '\033[34m')
	color_success=$(printf '\033[32m')
	color_warning=$(printf '\033[33m')
	color_error=$(printf '\033[31m')
	color_command=$(printf '\033[35m')
	color_reset=$(printf '\033[0m')
else
	color_info=
	color_success=
	color_warning=
	color_error=
	color_command=
	color_reset=
fi

log() {
	level=$1
	shift
	timestamp=$(date '+%Y-%m-%d %H:%M:%S')
	case "$level" in
		Info) color=$color_info ;;
		Success) color=$color_success ;;
		Warning) color=$color_warning ;;
		Error) color=$color_error ;;
		Command) color=$color_command ;;
		*) color= ;;
	esac
	printf '[%s] %s[%s]%s neovide-client: %s\n' "$timestamp" "$color" "$level" "$color_reset" "$*" >&2
}

log_command() {
	timestamp=$(date '+%Y-%m-%d %H:%M:%S')
	printf '[%s] %s[Command]%s neovide-client:' "$timestamp" "$color_command" "$color_reset" >&2
	for argument in "$@"; do
		printf ' [%s]' "$argument" >&2
	done
	printf '\n' >&2
}

port=6666
port_set=0
trace=0
ssh_verbose=
target=
while [ "$#" -gt 0 ]; do
	case "$1" in
		-p|--port)
			[ "$#" -gt 1 ] || {
				log Error "$1 requires a value"
				exit 2
			}
			port=$2
			port_set=1
			shift 2
			;;
		--port=*)
			port=${1#*=}
			port_set=1
			shift
			;;
		--trace)
			trace=1
			shift
			;;
		--ssh-verbose)
			ssh_verbose=-v
			shift
			;;
		-h|--help)
			usage
			exit 0
			;;
		--)
			shift
			[ "$#" -gt 0 ] || {
				log Error 'missing SSH host after --'
				exit 2
			}
			target=$1
			shift
			break
			;;
		-*)
			log Error "unknown option: $1"
			exit 2
			;;
		*)
			target=$1
			shift
			break
			;;
	esac
done

if [ -z "$target" ]; then
	log Error 'missing SSH host'
	usage
	exit 2
fi

if [ "$trace" -eq 1 ]; then
	set -x
fi

case "$(uname -s)" in
	Darwin)
		browser_opener=open
		operating_system=macOS
		if command -v swift >/dev/null 2>&1; then
			clipboard_backend=macos
		else
			clipboard_backend=none
		fi
		;;
	Linux)
		browser_opener=xdg-open
		operating_system=Linux
		if command -v wl-paste >/dev/null 2>&1; then
			clipboard_backend=wayland
		elif command -v xclip >/dev/null 2>&1; then
			clipboard_backend=x11
		else
			clipboard_backend=none
		fi
		;;
	*)
		log Error 'unsupported operating system'
		exit 1
		;;
esac

case "$target" in
	:*|-*)
		log Error "invalid SSH host: $target"
		usage
		exit 2
		;;
	*:*)
		ssh_host=${target%:*}
		if [ "$port_set" -eq 1 ]; then
			log Error 'port specified both in the target and with --port'
			exit 2
		fi
		port=${target##*:}
		;;
	*)
		ssh_host=$target
		;;
esac

case "$port" in
	""|*[!0-9]*)
		log Error 'port must be numeric'
		usage
		exit 2
		;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65532 ]; then
	log Error 'port must be between 1 and 65532'
	exit 2
fi

for dependency in nvim python3 ssh neovide "$browser_opener"; do
	command -v "$dependency" >/dev/null 2>&1 || {
		log Error "$dependency is not installed"
		exit 1
	}
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bridge="$script_dir/.neovide-url-bridge"
[ -x "$bridge" ] || {
	log Error "missing $bridge"
	exit 1
}

preview_port=$((port + 1))
fixed_open_port=$((port + 2))
fixed_image_port=$((port + 3))
client_tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/neovide-client.XXXXXX")
control_socket="$client_tmp_dir/ssh-control"
"$bridge" allocate --count 3 > "$client_tmp_dir/local-ports"
read -r local_nvim_port local_preview_port local_open_port < "$client_tmp_dir/local-ports"
bridge_pid=
tunnel_started=0

log Info "platform: $operating_system; browser opener: $browser_opener"
log Info "remote ports: Neovim $port, preview $preview_port; callback ports pending"
log Info "local ports: Neovim $local_nvim_port, preview $local_preview_port, callback $local_open_port"
if [ "$clipboard_backend" = none ]; then
	log Warning 'local image clipboard support is unavailable'
else
	log Info "local image clipboard backend: $clipboard_backend"
fi

cleanup() {
	if [ "$tunnel_started" -eq 1 ]; then
		log Info "stopping SSH tunnel to $ssh_host"
		ssh -S "$control_socket" -O exit "$ssh_host" >/dev/null 2>&1 || true
	fi
	if [ -n "$bridge_pid" ]; then
		log Info "stopping local browser bridge"
		kill "$bridge_pid" >/dev/null 2>&1 || true
		wait "$bridge_pid" 2>/dev/null || true
	fi
	rm -rf "$client_tmp_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

log Info "starting local browser bridge"
log_command "$bridge" serve --listen-port "$local_open_port" --remote-preview-port "$preview_port" --local-preview-port "$local_preview_port" --opener "$browser_opener" --clipboard-backend "$clipboard_backend"
"$bridge" serve \
	--listen-port "$local_open_port" \
	--remote-preview-port "$preview_port" \
	--local-preview-port "$local_preview_port" \
	--opener "$browser_opener" \
	--clipboard-backend "$clipboard_backend" &
bridge_pid=$!
"$bridge" wait --port "$local_open_port" --timeout 3
log Success "local browser bridge is ready"

log Info "creating SSH tunnel to $ssh_host"
log Info "forward: local 127.0.0.1:$local_nvim_port -> remote 127.0.0.1:$port"
log Info "forward: local 127.0.0.1:$local_preview_port -> remote 127.0.0.1:$preview_port"
log_command ssh ${ssh_verbose:+"$ssh_verbose"} -M -S "$control_socket" -o ControlPersist=no -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -fN -L "127.0.0.1:$local_nvim_port:127.0.0.1:$port" -L "127.0.0.1:$local_preview_port:127.0.0.1:$preview_port" "$ssh_host"
ssh -M -S "$control_socket" \
	${ssh_verbose:+"$ssh_verbose"} \
	-o ControlPersist=no \
	-o ExitOnForwardFailure=yes \
	-o ServerAliveInterval=15 \
	-o ServerAliveCountMax=3 \
	-fN \
	-L "127.0.0.1:$local_nvim_port:127.0.0.1:$port" \
	-L "127.0.0.1:$local_preview_port:127.0.0.1:$preview_port" \
	"$ssh_host"
tunnel_started=1
log Success "SSH tunnel established"

log Info "waiting for remote Neovim"
"$bridge" wait --port "$local_nvim_port" --timeout "${NEOVIDE_CONNECT_TIMEOUT:-15}"
log Success "remote Neovim is reachable"

port_api=$(nvim --server "127.0.0.1:$local_nvim_port" --remote-expr "luaeval(\"type(require('luanphan.neovide_remote').set_ports)\")" 2>/dev/null || true)
if [ "$port_api" = function ]; then
	log Info "allocating dynamic remote callback ports"
	log_command ssh -S "$control_socket" -O forward -R "127.0.0.1:0:127.0.0.1:$local_open_port" "$ssh_host"
	open_port=$(ssh -S "$control_socket" -O forward -R "127.0.0.1:0:127.0.0.1:$local_open_port" "$ssh_host")
	log_command ssh -S "$control_socket" -O forward -R "127.0.0.1:0:127.0.0.1:$local_open_port" "$ssh_host"
	image_port=$(ssh -S "$control_socket" -O forward -R "127.0.0.1:0:127.0.0.1:$local_open_port" "$ssh_host")
else
	log Warning "remote Neovim does not support dynamic callback ports; using fixed ports"
	open_port=$fixed_open_port
	image_port=$fixed_image_port
	log_command ssh -S "$control_socket" -O forward -R "127.0.0.1:$open_port:127.0.0.1:$local_open_port" -R "127.0.0.1:$image_port:127.0.0.1:$local_open_port" "$ssh_host"
	ssh -S "$control_socket" -O forward \
		-R "127.0.0.1:$open_port:127.0.0.1:$local_open_port" \
		-R "127.0.0.1:$image_port:127.0.0.1:$local_open_port" \
		"$ssh_host"
fi

case "$open_port:$image_port" in
	*[!0-9:]*|:*|*:) log Error "SSH returned invalid callback ports: $open_port $image_port"; exit 1 ;;
esac
if [ "$open_port" -lt 1 ] || [ "$open_port" -gt 65535 ] || [ "$image_port" -lt 1 ] || [ "$image_port" -gt 65535 ]; then
	log Error "SSH returned out-of-range callback ports: $open_port $image_port"
	exit 1
fi

log Success "callback ports allocated: browser $open_port, image $image_port"
log Info "callback: remote 127.0.0.1:$open_port -> local 127.0.0.1:$local_open_port"
log Info "callback: remote 127.0.0.1:$image_port -> local 127.0.0.1:$local_open_port (image clipboard)"
if [ "$port_api" = function ]; then
	port_expression="luaeval(\"require('luanphan.neovide_remote').set_ports(_A[1], _A[2])\", [$open_port, $image_port])"
	log Command "updating remote Neovim callback ports"
	nvim --server "127.0.0.1:$local_nvim_port" --remote-expr "$port_expression" >/dev/null
	log Success "remote Neovim callback ports updated"
fi

log Info "launching Neovide"
log_command neovide --no-fork --server "127.0.0.1:$local_nvim_port" "$@"
neovide_status=0
neovide --no-fork --server "127.0.0.1:$local_nvim_port" "$@" || neovide_status=$?
if [ "$neovide_status" -eq 0 ]; then
	log Success "Neovide exited with status $neovide_status"
else
	log Error "Neovide exited with status $neovide_status"
fi
exit "$neovide_status"
