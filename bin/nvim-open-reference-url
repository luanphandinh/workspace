#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

for python in \
	"$HOME/.nix-profile/bin/python3" \
	"/nix/var/nix/profiles/default/bin/python3" \
	"/opt/homebrew/bin/python3" \
	"/usr/local/bin/python3"
do
	if [ -x "$python" ]; then
		exec "$python" "$script_dir/nvim-open-reference-url.py" "$@"
	fi
done

python=$(command -v python3 || true)
if [ -z "$python" ]; then
	printf '%s\n' 'nvim-open-reference-url: python3 is not available' >&2
	exit 1
fi

exec "$python" "$script_dir/nvim-open-reference-url.py" "$@"
