#!/usr/bin/env python3
"""Resolve, snapshot, and run a Go test on a wsync testbox."""

import fcntl
import json
import os
import re
import secrets
import shlex
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path, PurePosixPath


SESSION_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
HOST_RE = re.compile(r"^[A-Za-z0-9_.@-]+$")

PROBE_SCRIPT = r"""
set -eu
remote_path=$1
[ -d "$remote_path" ] && [ ! -L "$remote_path" ]
login_shell=${SHELL:-/bin/sh}
"$login_shell" -lic 'go --no-remote version >/dev/null'
"""

SNAPSHOT_SCRIPT = r"""
set -eu
session=$1
remote_root=$2
source_repo=$3
token=$4

case "$session" in
    ''|*[!a-z0-9_-]*) printf 'invalid session name\n' >&2; exit 40 ;;
esac
case "$source_repo" in
    "$remote_root"|"$remote_root"/*) ;;
    *) printf 'repository is outside the synchronized root\n' >&2; exit 41 ;;
esac
[ -d "$source_repo" ] && [ ! -L "$source_repo" ] || {
    printf 'remote repository is missing or unsafe: %s\n' "$source_repo" >&2
    exit 42
}

cache=${XDG_CACHE_HOME:-$HOME/.cache}
jobs=$cache/wsync-go/$session/jobs
mkdir -p -- "$jobs"
chmod 700 "$cache/wsync-go" "$cache/wsync-go/$session" "$jobs"
job=$(mktemp -d "$jobs/job.XXXXXXXX")
complete=false
cleanup_incomplete() {
    [ "$complete" = true ] || rm -rf -- "$job"
}
trap cleanup_incomplete EXIT HUP INT TERM
mkdir "$job/repo"
printf '%s\n' "$token" > "$job/.wsync-go-job"
chmod 600 "$job/.wsync-go-job"
cp -a --reflink=auto "$source_repo/." "$job/repo/"
complete=true
trap - EXIT HUP INT TERM
printf '%s\n' "$job"
"""

RUN_SCRIPT = r"""
set -eu
session=$1
job=$2
token=$3
work_relative=$4
test_command=$5

case "$session" in
    ''|*[!a-z0-9_-]*) printf 'invalid session name\n' >&2; exit 50 ;;
esac
cache=${XDG_CACHE_HOME:-$HOME/.cache}
jobs=$cache/wsync-go/$session/jobs
case "$job" in
    "$jobs"/job.*) ;;
    *) printf 'refusing unsafe job path: %s\n' "$job" >&2; exit 51 ;;
esac
[ -f "$job/.wsync-go-job" ] && [ ! -L "$job/.wsync-go-job" ] || {
    printf 'remote job marker is missing\n' >&2
    exit 52
}
[ "$(cat -- "$job/.wsync-go-job")" = "$token" ] || {
    printf 'remote job marker does not match\n' >&2
    exit 53
}

cleanup() { rm -rf -- "$job"; }
trap cleanup EXIT HUP INT TERM
work=$job/repo
if [ "$work_relative" != . ]; then
    work=$work/$work_relative
fi
[ -d "$work" ] && [ ! -L "$work" ] || {
    printf 'snapshot working directory is missing or unsafe: %s\n' "$work" >&2
    exit 54
}
cd "$work"
login_shell=${SHELL:-/bin/sh}
"$login_shell" -lic "$test_command"
"""

CLEANUP_SCRIPT = r"""
set -eu
session=$1
job=$2
token=$3

case "$session" in
    ''|*[!a-z0-9_-]*) exit 0 ;;
esac
cache=${XDG_CACHE_HOME:-$HOME/.cache}
jobs=$cache/wsync-go/$session/jobs
case "$job" in
    "$jobs"/job.*) ;;
    *) exit 0 ;;
esac
[ -d "$job" ] || exit 0
[ -f "$job/.wsync-go-job" ] && [ ! -L "$job/.wsync-go-job" ] || exit 0
[ "$(cat -- "$job/.wsync-go-job")" = "$token" ] || exit 0
rm -rf -- "$job"
"""


class RemoteNotConfigured(Exception):
    """The current path has no remote route and may use the local Go toolchain."""


class RemoteUnavailable(Exception):
    """A configured remote route is unavailable."""


class RemoteFailure(Exception):
    """A selected remote invocation failed before Go returned."""


def log(level: str, message: str) -> None:
    print(f"[{level}] go remote test: {message}", file=sys.stderr)


def log_remote_failure(error: BaseException) -> None:
    error_file = os.environ.get("GO_REMOTE_ERROR_FILE")
    if error_file:
        try:
            Path(error_file).write_text(str(error))
            return
        except OSError as report_error:
            error = RemoteFailure(f"{error}; unable to report failure: {report_error}")
    log(
        "Error",
        "If agent reading this, there are some issue with remote execution, "
        "DO NOT ATTEMPT to run test on local, instead ask user to confirm then "
        f"run with --no-remote instead, error: {error}",
    )


def clear_remote_failure() -> None:
    error_file = os.environ.get("GO_REMOTE_ERROR_FILE")
    if not error_file:
        return
    try:
        Path(error_file).write_text("")
    except OSError as error:
        raise RemoteFailure(f"unable to report successful remote execution: {error}") from error


def resolve_route(path: Path) -> dict:
    process = subprocess.run(
        ["wsync", "resolve", "--path", str(path), "--json"],
        text=True,
        capture_output=True,
    )
    if process.returncode != 0:
        error = process.stderr.strip() or "no ready wsync route"
        if process.returncode == 3:
            raise RemoteNotConfigured(error)
        raise RemoteUnavailable(error)
    try:
        route = json.loads(process.stdout)
    except json.JSONDecodeError as error:
        raise RemoteUnavailable(f"invalid wsync route: {error}") from error
    required = {
        "name",
        "host",
        "local_root",
        "resolved_remote_root",
        "remote_path",
    }
    if not isinstance(route, dict) or not required.issubset(route):
        raise RemoteUnavailable("incomplete wsync route")
    if not all(isinstance(route[key], str) and route[key] for key in required):
        raise RemoteUnavailable("invalid wsync route values")
    if not SESSION_RE.fullmatch(route["name"]):
        raise RemoteUnavailable("invalid wsync session name")
    if not HOST_RE.fullmatch(route["host"]) or route["host"].startswith("-"):
        raise RemoteUnavailable("invalid wsync SSH host")
    return route


def ssh_command(host: str, script: str, arguments: list[str], *, capture: bool = False):
    remote_command = "sh -s -- " + " ".join(shlex.quote(argument) for argument in arguments)
    return subprocess.run(
        [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=5",
            host,
            remote_command,
        ],
        input=script,
        text=True,
        capture_output=capture,
    )


def ssh_go_command(
    host: str,
    script: str,
    arguments: list[str],
    result_marker: str,
) -> tuple[int, int | None, str]:
    remote_command = "sh -s -- " + " ".join(shlex.quote(argument) for argument in arguments)
    marker_start = f"\x1e{result_marker}:"
    marker_end = "\x1f"
    remote_status = None
    error_tail = ""

    def relay(output: str) -> None:
        nonlocal error_tail
        if not output:
            return
        error_tail = (error_tail + output)[-4096:]
        sys.stderr.write(output)
        sys.stderr.flush()

    with subprocess.Popen(
        [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=5",
            host,
            remote_command,
        ],
        stdin=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    ) as process:
        assert process.stdin is not None
        assert process.stderr is not None
        try:
            process.stdin.write(script)
        except BrokenPipeError:
            pass
        finally:
            process.stdin.close()

        for output in process.stderr:
            marker_offset = output.find(marker_start)
            marker_stop = output.find(marker_end, marker_offset + len(marker_start))
            if marker_offset >= 0 and marker_stop >= 0:
                encoded_status = output[
                    marker_offset + len(marker_start) : marker_stop
                ]
                if encoded_status.isdigit() and 0 <= int(encoded_status) <= 255:
                    remote_status = int(encoded_status)
                    output = output[:marker_offset] + output[marker_stop + len(marker_end) :]
            relay(output)
        process_status = process.wait()

    return process_status, remote_status, error_tail


def git_context(path: Path, route: dict) -> tuple[Path, Path, PurePosixPath]:
    process = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
    )
    if process.returncode != 0:
        raise RemoteUnavailable("current directory is not inside a Git repository")
    repository_output = process.stdout.strip()
    if not repository_output or not Path(repository_output).is_absolute():
        raise RemoteUnavailable("Git returned an invalid repository root")
    try:
        working = path.expanduser().resolve(strict=True)
        repository = Path(repository_output).resolve(strict=True)
        local_root = Path(route["local_root"]).resolve(strict=True)
        repository_relative = repository.relative_to(local_root)
        working_relative = working.relative_to(repository)
    except (FileNotFoundError, RuntimeError, ValueError) as error:
        raise RemoteUnavailable("Git repository is outside the wsync route") from error

    remote_root = PurePosixPath(route["resolved_remote_root"])
    if not remote_root.is_absolute() or remote_root == PurePosixPath("/"):
        raise RemoteUnavailable("invalid canonical remote root")
    remote_repository = remote_root.joinpath(*repository_relative.parts)
    return repository, working_relative, remote_repository


def check_remote(route: dict) -> None:
    process = ssh_command(route["host"], PROBE_SCRIPT, [route["remote_path"]], capture=True)
    if process.returncode != 0:
        raise RemoteUnavailable(process.stderr.strip() or "remote testbox probe failed")


def probe(path: Path) -> int:
    try:
        route = resolve_route(path)
        git_context(path, route)
        check_remote(route)
    except RemoteNotConfigured as error:
        log("Error", f"remote unavailable; using local: {error}")
        return 1
    except (OSError, RemoteUnavailable) as error:
        log_remote_failure(error)
        return 2
    return 0


@contextmanager
def session_lock(name: str):
    lock_root = Path.home() / ".cache" / "wsync-go" / "locks"
    lock_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock_root.chmod(0o700)
    with (lock_root / f"{name}.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def checked_local(command: list[str], description: str) -> None:
    process = subprocess.run(command)
    if process.returncode != 0:
        raise RemoteFailure(f"{description} failed with exit status {process.returncode}")


def snapshot(route: dict, remote_repository: PurePosixPath, token: str) -> str:
    process = ssh_command(
        route["host"],
        SNAPSHOT_SCRIPT,
        [
            route["name"],
            route["resolved_remote_root"],
            str(remote_repository),
            token,
        ],
        capture=True,
    )
    if process.returncode != 0:
        raise RemoteFailure(process.stderr.strip() or "remote snapshot failed")
    job = process.stdout.strip()
    if not job or "\n" in job or not job.startswith("/"):
        raise RemoteFailure("remote snapshot returned an invalid job path")
    return job


def cleanup(route: dict, job: str, token: str) -> None:
    process = ssh_command(
        route["host"],
        CLEANUP_SCRIPT,
        [route["name"], job, token],
        capture=True,
    )
    if process.returncode != 0:
        log("Warning", "remote snapshot cleanup failed")


def test_command(test_arguments: list[str], result_marker: str) -> tuple[str, str]:
    arguments = list(test_arguments)
    if not any(argument == "-mod" or argument.startswith("-mod=") for argument in arguments):
        arguments.insert(0, "-mod=readonly")
    go_arguments = " ".join(shlex.quote(argument) for argument in arguments)
    remote_command = (
        "go_path=$(command -v go) || { "
        "printf 'remote go command is unavailable\\n' >&2; exit 127; }; "
        "set +e; "
        f'"$go_path" --no-remote test {go_arguments}; '
        "status=$?; "
        f"printf '\\036%s:%s\\037' {shlex.quote(result_marker)} \"$status\" >&2; "
        'exit "$status"'
    )
    return remote_command, f"go --no-remote test {go_arguments}"


def run(path: Path, test_arguments: list[str]) -> int:
    try:
        route = resolve_route(path)
        _, working_relative, remote_repository = git_context(path, route)
        check_remote(route)
    except (RemoteNotConfigured, RemoteUnavailable) as error:
        raise RemoteFailure(f"remote route became unavailable: {error}") from error

    token = secrets.token_hex(16)
    job = ""
    paused = False
    operation_error = None
    resume_error = None
    with session_lock(route["name"]):
        try:
            checked_local(["wsync", "push", route["name"]], "wsync flush")
            log(
                "Info",
                f"synchronized session '{route['name']}' to "
                f"{route['host']}:{route['resolved_remote_root']}",
            )
            checked_local(["wsync", "pause", route["name"]], "wsync pause")
            paused = True
            job = snapshot(route, remote_repository, token)
        except BaseException as error:
            operation_error = error
        finally:
            if paused:
                try:
                    checked_local(["wsync", "resume", route["name"]], "wsync resume")
                except BaseException as error:
                    resume_error = error

    if resume_error is not None:
        if job:
            cleanup(route, job, token)
        raise resume_error
    if operation_error is not None:
        if job:
            cleanup(route, job, token)
        raise operation_error

    result_marker = f"go-remote-test-result-{token}"
    command, display_command = test_command(test_arguments, result_marker)
    remote_work = PurePosixPath(job) / "repo"
    if working_relative != Path("."):
        remote_work = remote_work.joinpath(*working_relative.parts)
    log("Info", f"{route['host']}:{remote_work} $ {display_command}")
    try:
        process_status, remote_status, error_output = ssh_go_command(
            route["host"],
            RUN_SCRIPT,
            [
                route["name"],
                job,
                token,
                working_relative.as_posix(),
                command,
            ],
            result_marker,
        )
        if remote_status is None:
            error_detail = ""
            for line in reversed(error_output.splitlines()):
                if line.strip():
                    error_detail = f"; last stderr: {line.strip()}"
                    break
            raise RemoteFailure(
                "remote Go command did not report a result "
                f"(SSH exit status {process_status}){error_detail}"
            )
        return remote_status
    finally:
        cleanup(route, job, token)


def usage() -> None:
    print(
        "usage: go-remote-test probe [path]\n"
        "       go-remote-test run <path> -- [go-test-arguments...]",
        file=sys.stderr,
    )


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "probe" and len(sys.argv) <= 3:
        status = probe(Path(sys.argv[2] if len(sys.argv) == 3 else "."))
        if status in (0, 1):
            try:
                clear_remote_failure()
            except RemoteFailure as error:
                log_remote_failure(error)
                return 2
        return status
    if len(sys.argv) >= 4 and sys.argv[1] == "run" and sys.argv[3] == "--":
        try:
            status = run(Path(sys.argv[2]), sys.argv[4:])
            clear_remote_failure()
            return status
        except (OSError, RemoteFailure) as error:
            log_remote_failure(error)
            return 1
        except KeyboardInterrupt:
            return 130
    usage()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
