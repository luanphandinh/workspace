#!/bin/sh
set -eu

agent="${1:?agent name is required}"
cwd="$(pwd -P 2>/dev/null || pwd)"

if command -v sha256sum >/dev/null 2>&1; then
	key="$(printf '%s\n%s' "$agent" "$cwd" | sha256sum | awk '{ print $1 }')"
else
	key="$(printf '%s\n%s' "$agent" "$cwd" | shasum -a 256 | awk '{ print $1 }')"
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/workspace-agent-status"
mkdir -p "$state_dir"
state_file="$state_dir/$key"
state_tmp="$state_file.$$"
printf '%s\n' idle >"$state_tmp"
mv -f "$state_tmp" "$state_file"
