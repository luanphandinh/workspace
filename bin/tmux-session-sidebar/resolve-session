#!/bin/sh
requested="${1:-}"
case "$requested" in
	''|*'#{'*) ;;
	*) printf '%s\n' "$requested"; exit 0 ;;
esac

if [ -n "${TMUX_PANE:-}" ]; then
	target="$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null || :)"
	[ -n "$target" ] && {
		printf '%s\n' "$target"
		exit 0
	}
fi

tmux display-message -p '#{session_id}'
