#!/bin/sh
PIN_FILE="${HOME}/.config/tmux/pinned-sessions"
TAB="$(printf '\t')"
target="${1:-}"

if [ -n "$target" ]; then
	profile="$(tmux show-options -qv -t "$target" '@pin_sidebar_profile' 2>/dev/null || :)"
	id="$(tmux display-message -p -t "$target" '#{session_id}' 2>/dev/null || :)"
	name="$(tmux display-message -p -t "$target" '#S' 2>/dev/null || :)"
else
	profile="$(tmux show-options -qv '@pin_sidebar_profile' 2>/dev/null || :)"
	id="$(tmux display-message -p '#{session_id}' 2>/dev/null || :)"
	name="$(tmux display-message -p '#S' 2>/dev/null || :)"
fi

case "$profile" in
	''|*[!A-Za-z0-9._-]*) profile="" ;;
esac

if [ -n "$profile" ]; then
	printf '%s\n' "$profile"
	exit 0
fi

if [ -s "$PIN_FILE" ]; then
	profile="$(awk -F "$TAB" -v id="$id" -v name="$name" '
		$1 == "@profile" { next }
		NF >= 3 && ($3 == id || $2 == name) { print $1; exit }
		NF == 2 && ($2 == id || $1 == name) { print "default"; exit }
		$0 == id || $0 == name { print "default"; exit }
	' "$PIN_FILE")"
fi

printf '%s\n' "${profile:-default}"
