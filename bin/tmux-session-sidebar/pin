#!/bin/sh
set -e

PIN_FILE="${HOME}/.config/tmux/pinned-sessions"
TAB="$(printf '\t')"
action="${1:-pick}"

profile_list() {
	current="$1"
	{
		printf 'default\n'
		awk -F "$TAB" '
			$1 == "@profile" && NF >= 2 { print $2; next }
			NF >= 3 { print $1 }
		' "$PIN_FILE" 2>/dev/null || :
		printf '%s\n' "$current"
	} | awk 'NF && $0 != "unpin" && !seen[$0]++'
}

select_action() {
	selected="$1"
	target="$2"
	if [ "$selected" = "unpin" ]; then
		"$HOME/bin/tmux-session-sidebar/toggle" unpin "$target"
	else
		"$HOME/bin/tmux-session-sidebar/toggle" pin "$selected" "$target"
	fi
}

case "$action" in
	select)
		target="$("$HOME/bin/tmux-session-sidebar/resolve-session" "${3:-}")"
		select_action "${2:-}" "$target"
		;;
	pick)
		target="$("$HOME/bin/tmux-session-sidebar/resolve-session" "${2:-}")"
		current="$("$HOME/bin/tmux-session-sidebar/current-profile" "$target")"
		if ! command -v fzf >/dev/null 2>&1; then
			tmux command-prompt -p "Pin profile or unpin:" \
				"run-shell '$HOME/bin/tmux-session-sidebar/pin select %% $target'"
			exit 0
		fi
		selected="$(
			{
				profile_list "$current"
				printf 'unpin\n'
			} | fzf --height '~100%' --prompt 'pin session> '
		)" || exit 0
		[ -n "$selected" ] && select_action "$selected" "$target"
		;;
	*)
		tmux display-message "usage: pin [pick|select <profile|unpin>]"
		exit 1
		;;
esac
