#!/bin/sh
set -e

PIN_FILE="${HOME}/.config/tmux/pinned-sessions"
TAB="$(printf '\t')"
action="${1:-pick}"

valid_profile() {
	case "$1" in
		''|unpin|*[!A-Za-z0-9._-]*) return 1 ;;
		*) return 0 ;;
	esac
}

select_profile() {
	profile="$1"
	target="$("$HOME/bin/tmux-session-sidebar/resolve-session" "${2:-}")"
	if ! valid_profile "$profile"; then
		tmux display-message "profile names may use letters, numbers, dot, underscore, and dash; unpin is reserved"
		return 1
	fi
	mkdir -p "$(dirname "$PIN_FILE")"
	[ -f "$PIN_FILE" ] || : > "$PIN_FILE"
	if ! awk -F "$TAB" -v profile="$profile" '
		$1 == "@profile" && $2 == profile { found = 1 }
		END { exit found ? 0 : 1 }
	' "$PIN_FILE"; then
		printf '@profile\t%s\n' "$profile" >> "$PIN_FILE"
	fi
	tmux set-option -q -t "$target" '@pin_sidebar_profile' "$profile"
	tmux display-message "pinned profile: $profile"
	"$HOME/bin/tmux-session-sidebar/broadcast-redraw" >/dev/null 2>&1 || :
}

profile_list() {
	current="$1"
	{
		printf '%s\n' "$current"
		awk -F "$TAB" '
			$1 == "@profile" && NF >= 2 { print $2; next }
			NF >= 3 { print $1; next }
			NF > 0 { print "default" }
		' "$PIN_FILE" 2>/dev/null || :
	} | awk 'NF && !seen[$0]++'
}

case "$action" in
	select)
		select_profile "${2:-}" "${3:-}"
		;;
	pick)
		target="$("$HOME/bin/tmux-session-sidebar/resolve-session" "${2:-}")"
		current="$("$HOME/bin/tmux-session-sidebar/current-profile" "$target")"
		if ! command -v fzf >/dev/null 2>&1; then
			tmux command-prompt -p "Pinned profile:" \
				"run-shell '$HOME/bin/tmux-session-sidebar/profile select %% $target'"
			exit 0
		fi
		result="$(profile_list "$current" | fzf \
			--height '~100%' \
			--prompt 'pinned profile> ' \
			--print-query \
			--bind 'enter:accept')" || exit 0
		selected="$(printf '%s\n' "$result" | awk '
			NR == 1 { query = $0; next }
			{ selected = $0 }
			END {
				if (query != "" && query != selected)
					print query
				else
					print (selected != "" ? selected : query)
			}
		')"
		[ -n "$selected" ] && select_profile "$selected" "$target"
		;;
	next|prev)
		target="$("$HOME/bin/tmux-session-sidebar/resolve-session" "${2:-}")"
		current="$("$HOME/bin/tmux-session-sidebar/current-profile" "$target")"
		selected="$(profile_list "$current" | awk -v current="$current" -v direction="$action" '
			{ profiles[++count] = $0; if ($0 == current) active = count }
			END {
				if (count == 0) exit
				if (!active) active = 1
				if (direction == "prev") {
					active--
					if (active < 1) active = count
				} else {
					active = (active % count) + 1
				}
				print profiles[active]
			}
		')"
		[ -n "$selected" ] && select_profile "$selected" "$target"
		;;
	*)
		tmux display-message "usage: profile [pick|select <name>|next|prev]"
		exit 1
		;;
esac
