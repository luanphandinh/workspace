#!/bin/sh
set -eu

notify_title="${AGENT_NOTIFY_TITLE:-${CODEX_NOTIFY_TITLE:-Codex}}"
notify_group_override="${AGENT_NOTIFY_GROUP:-${CODEX_NOTIFY_GROUP:-}}"
notify_group="${notify_group_override:-agent-notify-$notify_title}"
activate_app="${AGENT_NOTIFY_ACTIVATE_APP:-${CODEX_NOTIFY_ACTIVATE_APP:-}}"

get_tmux_cmd() {
	if [ -n "${TMUX_BIN:-}" ]; then
		printf '%s\n' "$TMUX_BIN"
		return 0
	fi
	command -v tmux 2>/dev/null
}

tmux_format() {
	tmux_cmd="$1"
	pane="$2"
	format="$3"
	if [ -n "$pane" ]; then
		"$tmux_cmd" display-message -p -t "$pane" "$format" 2>/dev/null || :
	else
		"$tmux_cmd" display-message -p "$format" 2>/dev/null || :
	fi
}

client_for_pane() {
	tmux_cmd="$1"
	pane="$2"
	target_session="$(tmux_format "$tmux_cmd" "$pane" '#{session_id}')"
	[ -n "$target_session" ] || return 1

	tab="$(printf '\t')"
	pin_file="${HOME}/.config/tmux/pinned-sessions"
	[ -f "$pin_file" ] || pin_file="/dev/null"
	"$tmux_cmd" list-clients -F '#{client_activity}	#{client_name}	#{client_pid}	#{session_id}' 2>/dev/null |
		awk -F "$tab" -v target="$target_session" '
			FILENAME != "-" {
				if ($1 != "@profile" && NF >= 3) profile_by_session[$3] = $1
				next
			}
			NF >= 4 {
				priority = 0
				if ($4 == target) {
					priority = 2
				} else if (profile_by_session[target] != "" && profile_by_session[$4] == profile_by_session[target]) {
					priority = 1
				}
				if (priority > best_priority || (priority == best_priority && priority > 0 && $1 >= latest)) {
					best_priority = priority
					latest = $1
					client = $2
					pid = $3
				}
			}
			END {
				if (best_priority > 0) print client "\t" pid
			}
		' "$pin_file" -
}

process_env_value() {
	pid="$1"
	name="$2"
	if [ -r "/proc/$pid/environ" ]; then
		tr '\0' '\n' <"/proc/$pid/environ"
	elif command -v ps >/dev/null 2>&1; then
		ps eww -p "$pid" -o command= 2>/dev/null | tr ' ' '\n'
	else
		return 1
	fi |
		awk -v prefix="$name=" '
			index($0, prefix) == 1 { value = substr($0, length(prefix) + 1) }
			END {
				if (value != "") print value
			}
		'
}

pane_for_cwd() {
	tmux_cmd="$1"
	cwd="$2"
	cwd_logical="${3:-$cwd}"
	[ -n "$cwd" ] || return 1

	tab="$(printf '\t')"
	"$tmux_cmd" list-panes -a -F '#{pane_id}	#{pane_current_path}	#{pane_active}	#{window_active}	#{session_attached}' 2>/dev/null |
		awk -F "$tab" -v cwd="$cwd" -v cwd_logical="$cwd_logical" '
			$1 ~ /^%/ && ($2 == cwd || $2 == cwd_logical) {
				score = ($3 == "1") + ($4 == "1") + ($5 != "0")
				if (score >= best) {
					best = score
					pane = $1
				}
			}
			END {
				if (pane != "") print pane
			}
		'
}

usable_tmux_pane() {
	tmux_cmd="$1"
	pane="$2"
	[ -n "$pane" ] || return 1

	pane_id="$(tmux_format "$tmux_cmd" "$pane" '#{pane_id}')"
	target_window="$(tmux_format "$tmux_cmd" "$pane" '#{session_name}:#{window_index}')"
	case "$pane_id" in
		%*) ;;
		*) return 1 ;;
	esac
	case "$target_window" in
		"" | ":" | ":." | ".") return 1 ;;
	esac

	printf '%s\n' "$pane_id"
}

resolve_tmux_pane() {
	tmux_cmd="$1"
	cwd="$(pwd -P 2>/dev/null || pwd)"
	cwd_pane="$(pane_for_cwd "$tmux_cmd" "$cwd" "${PWD:-$cwd}" || :)"
	if [ -n "$cwd_pane" ]; then
		resolved_pane="$(usable_tmux_pane "$tmux_cmd" "$cwd_pane" || :)"
		if [ -n "$resolved_pane" ]; then
			printf '%s\n' "$resolved_pane"
			return 0
		fi
	fi

	if [ -n "${TMUX_PANE:-}" ]; then
		resolved_pane="$(usable_tmux_pane "$tmux_cmd" "$TMUX_PANE" || :)"
		if [ -n "$resolved_pane" ]; then
			printf '%s\n' "$resolved_pane"
			return 0
		fi
	fi

	current_pane="$(tmux_format "$tmux_cmd" "" '#{pane_id}')"
	case "$current_pane" in
		%*) usable_tmux_pane "$tmux_cmd" "$current_pane" || : ;;
	esac
}

focus_kitty_window() {
	window_id="$1"
	listen_on="$2"
	[ -n "$window_id" ] && [ -n "$listen_on" ] || return 1
	case "$activate_app" in
		kitty | Kitty | kitty.app | Kitty.app | */kitty | */kitty.app) ;;
		*) return 1 ;;
	esac

	if command -v kitten >/dev/null 2>&1; then
		kitten @ --to "$listen_on" focus-window --match "id:$window_id" >/dev/null 2>&1
	elif command -v kitty >/dev/null 2>&1; then
		kitty @ --to "$listen_on" focus-window --match "id:$window_id" >/dev/null 2>&1
	else
		return 1
	fi
}

jump_to_tmux_pane() {
	pane="${1:-}"
	requested_client="${2:-}"
	kitty_window_id="${3:-}"
	kitty_listen_on="${4:-}"
	[ -n "$pane" ] || exit 0
	tmux_cmd="$(get_tmux_cmd || :)"
	[ -n "$tmux_cmd" ] || exit 0

	target_pane="$(usable_tmux_pane "$tmux_cmd" "$pane" || :)"
	[ -n "$target_pane" ] || exit 0
	target_window="$(tmux_format "$tmux_cmd" "$target_pane" '#{session_name}:#{window_index}')"
	case "$target_window" in
		"" | ":" | ":." | ".") exit 0 ;;
	esac

	"$tmux_cmd" select-window -t "$target_window" >/dev/null 2>&1 || :
	"$tmux_cmd" select-pane -t "$target_pane" >/dev/null 2>&1 || :
	"$tmux_cmd" display-message -t "$target_pane" "$notify_title notification focused #{session_name}:#{window_index}.#{pane_index}" >/dev/null 2>&1 || :

	tab="$(printf '\t')"
	target_client=""
	if [ -n "$requested_client" ]; then
		target_client="$("$tmux_cmd" list-clients -F '#{client_name}' 2>/dev/null |
			awk -v requested="$requested_client" '$0 == requested { print; exit }')"
	fi
	if [ -z "$target_client" ]; then
		target_client="$(client_for_pane "$tmux_cmd" "$target_pane" | awk -F "$tab" 'NR == 1 { print $1 }')"
	fi
	if [ -z "$target_client" ]; then
		target_client="$("$tmux_cmd" list-clients -F '#{client_activity}	#{client_name}' 2>/dev/null |
			awk -F "$tab" 'NF >= 2 && (!found || $1 >= latest) { latest = $1; client = $2; found = 1 } END { print client }')"
	fi
	if [ -n "$target_client" ]; then
		"$tmux_cmd" switch-client -c "$target_client" -t "$target_pane" >/dev/null 2>&1 || :
	fi

	if focus_kitty_window "$kitty_window_id" "$kitty_listen_on"; then
		:
	elif [ -n "$activate_app" ] && command -v open >/dev/null 2>&1; then
		open -a "$activate_app" >/dev/null 2>&1 || :
	elif [ -n "$activate_app" ] && command -v osascript >/dev/null 2>&1; then
		osascript \
			-e 'on run argv' \
			-e 'tell application (item 1 of argv) to activate' \
			-e 'end run' \
			"$activate_app" >/dev/null 2>&1 || :
	fi
}

shell_quote() {
	printf "'%s'" "$(printf "%s" "$1" | sed "s/'/'\\\\''/g")"
}

notification_group() {
	suffix="${1:-}"
	if [ -n "$notify_group_override" ] || [ -z "$suffix" ]; then
		printf '%s\n' "$notify_group"
		return 0
	fi
	safe_suffix="$(printf '%s' "$suffix" | sed 's/[^[:alnum:]_.-]/_/g')"
	printf '%s-%s\n' "$notify_group" "$safe_suffix"
}

if [ "${1:-}" = "--jump-tmux" ]; then
	jump_pane="${2:-}"
	jump_client=""
	jump_kitty_window=""
	jump_kitty_listen_on=""
	shift 2
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--tmux-client)
				jump_client="${2:-}"
				shift 2
				;;
			--kitty-window)
				jump_kitty_window="${2:-}"
				shift 2
				;;
			--kitty-listen-on)
				jump_kitty_listen_on="${2:-}"
				shift 2
				;;
			*)
				shift
				;;
		esac
	done
	jump_to_tmux_pane "$jump_pane" "$jump_client" "$jump_kitty_window" "$jump_kitty_listen_on"
	exit 0
fi

payload="${1:-}"
if [ -z "$payload" ] && [ ! -t 0 ]; then
	payload="$(cat)"
fi

cwd="$(pwd -P 2>/dev/null || pwd)"
case "$cwd" in
	"$HOME") display_path="~" ;;
	"$HOME"/*) display_path="~/${cwd#"$HOME"/}" ;;
	*) display_path="$cwd" ;;
esac
message="Task complete: $display_path"

script_path="$(CDPATH= cd "$(dirname "$0")" 2>/dev/null && pwd -P)/$(basename "$0")"

if command -v terminal-notifier >/dev/null 2>&1; then
	tmux_cmd="$(get_tmux_cmd || :)"
	notify_pane=""
	if [ -n "$tmux_cmd" ]; then
		notify_pane="$(resolve_tmux_pane "$tmux_cmd")"
	fi
	notify_group_current="$(notification_group "$notify_pane")"

	if [ -n "$notify_pane" ]; then
		tmux_target="$(tmux_format "$tmux_cmd" "$notify_pane" '#{session_name}:#{window_index}.#{pane_index}')"
		click_cmd="$(shell_quote "$script_path") --jump-tmux $(shell_quote "$notify_pane")"
		tab="$(printf '\t')"
		notify_client_info="$(client_for_pane "$tmux_cmd" "$notify_pane" || :)"
		notify_client="$(printf '%s\n' "$notify_client_info" | awk -F "$tab" 'NR == 1 { print $1 }')"
		notify_client_pid="$(printf '%s\n' "$notify_client_info" | awk -F "$tab" 'NR == 1 { print $2 }')"
		if [ -n "$notify_client" ]; then
			click_cmd="$click_cmd --tmux-client $(shell_quote "$notify_client")"
		fi
		if [ -n "$notify_client_pid" ]; then
			kitty_window_id="$(process_env_value "$notify_client_pid" KITTY_WINDOW_ID || :)"
			kitty_listen_on="$(process_env_value "$notify_client_pid" KITTY_LISTEN_ON || :)"
			if [ -n "$kitty_window_id" ]; then
				click_cmd="$click_cmd --kitty-window $(shell_quote "$kitty_window_id")"
			fi
			if [ -n "$kitty_listen_on" ]; then
				click_cmd="$click_cmd --kitty-listen-on $(shell_quote "$kitty_listen_on")"
			fi
		fi
		if [ -n "$tmux_cmd" ]; then
			click_cmd="TMUX_BIN=$(shell_quote "$tmux_cmd") $click_cmd"
		fi
		if [ -n "$activate_app" ]; then
			click_cmd="AGENT_NOTIFY_ACTIVATE_APP=$(shell_quote "$activate_app") $click_cmd"
		fi
		if [ -n "${TMUX:-}" ]; then
			click_cmd="TMUX=$(shell_quote "$TMUX") $click_cmd"
		fi
		if [ -n "$tmux_target" ]; then
			terminal-notifier -title "$notify_title" -message "$message" -subtitle "tmux $tmux_target" -group "$notify_group_current" -ignoreDnD -execute "$click_cmd" >/dev/null 2>&1 || :
		else
			terminal-notifier -title "$notify_title" -message "$message" -group "$notify_group_current" -ignoreDnD -execute "$click_cmd" >/dev/null 2>&1 || :
		fi
	else
		terminal-notifier -title "$notify_title" -message "$message" -group "$notify_group_current" -ignoreDnD >/dev/null 2>&1 || :
	fi
elif command -v osascript >/dev/null 2>&1; then
	osascript \
		-e 'on run argv' \
		-e 'display notification (item 1 of argv) with title (item 2 of argv)' \
		-e 'end run' \
		"$message" "$notify_title" >/dev/null 2>&1 || :
fi

if [ -n "${TMUX:-}" ]; then
	tmux_cmd="$(get_tmux_cmd || :)"
	if [ -n "$tmux_cmd" ]; then
		"$tmux_cmd" display-message "$notify_title $message" >/dev/null 2>&1 || :
		notify_pane="$(resolve_tmux_pane "$tmux_cmd")"
	else
		notify_pane=""
	fi
	if [ -n "$notify_pane" ]; then
		pane_tty="$(tmux_format "$tmux_cmd" "$notify_pane" '#{pane_tty}')"
		if [ -n "$pane_tty" ] && [ -w "$pane_tty" ]; then
			printf '\a' >"$pane_tty" 2>/dev/null || :
		fi
	fi
fi

if tty_path="$(tty 2>/dev/null)" && [ "$tty_path" != "not a tty" ]; then
	printf '\a' >"$tty_path" 2>/dev/null || :
fi
