#!/bin/sh
set -eu

workspace_file="${1:-$HOME/bin/shell/workspace.sh}"
workspace_env_file="${2:-$HOME/bin/shell/workspace-env.sh}"
[ -f "$workspace_file" ] || {
	printf 'workspace-shell-sync: missing %s\n' "$workspace_file" >&2
	exit 1
}
[ -f "$workspace_env_file" ] || {
	printf 'workspace-shell-sync: missing %s\n' "$workspace_env_file" >&2
	exit 1
}
interactive_source_line='[ -f "$HOME/bin/shell/workspace.sh" ] && . "$HOME/bin/shell/workspace.sh"'
environment_source_line='[ -r "$HOME/bin/shell/workspace-env.sh" ] && . "$HOME/bin/shell/workspace-env.sh"'

# Persist the prefix for tools that invoke npm without sourcing shell startup.
if command -v npm >/dev/null 2>&1; then
	npm config set prefix "${NPM_CONFIG_PREFIX:-$HOME/.local}" --location=user
fi

sync_profile() {
	profile=$1
	source_line=$2
	touch "$profile"
	tmp="$(mktemp -t workspace-shell-profile.XXXXXX)"
	awk -v source_line="$source_line" '
		$0 == "# >>> workspace-bin" {
			in_block = 1
			next
		}
		$0 == "# <<< workspace-bin" {
			in_block = 0
			next
		}
		in_block {
			next
		}
		$0 == source_line {
			if (!source_seen) {
				print
				source_seen = 1
			}
			next
		}
		{
			print
		}
		END {
			if (!source_seen) {
				print source_line
			}
		}
	' "$profile" > "$tmp"

	if [ -s "$profile" ]; then
		last_hex="$(tail -c 1 "$profile" | od -An -tx1 | tr -d ' \n')"
		if [ "$last_hex" != "0a" ]; then
			with_newline="$(mktemp -t workspace-shell-profile.XXXXXX)"
			cat "$profile" > "$with_newline"
			printf '\n' >> "$with_newline"
			cat "$with_newline" > "$profile"
			rm -f "$with_newline"
		fi
	fi

	if cmp -s "$tmp" "$profile"; then
		rm -f "$tmp"
		printf 'workspace-bin: unchanged %s\n' "$profile"
		return
	fi

	cat "$tmp" > "$profile"
	rm -f "$tmp"
	printf 'workspace-bin: updated %s\n' "$profile"
}

sync_profile "$HOME/.zprofile" "$environment_source_line"
for profile in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.profile"; do
	sync_profile "$profile" "$interactive_source_line"
done
