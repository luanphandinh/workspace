#!/bin/sh
# ~/bin/go — wrapper around the real `go` binary:
#   * selects a repository-compatible Go toolchain for every command
# For `go test` it additionally:
#   * routes through a healthy covering wsync session when available
#   * always runs with GOWORK=off (per-module deps; see workspace notes)
#   * optionally injects -toolexec / -gcflags read from env
#
# Both flags are env-driven only — no hardcoded defaults — so a clean shell
# gives a transparent `go test` (still GOWORK=off). Set the LOCAL_GO_* vars in
# your shell rc / direnv to opt in. The LOCAL_ prefix keeps these out of Go's
# own GO* namespace (GOFLAGS / GOWORK / GOTOOLCHAIN / etc.).
#
# Real-go discovery: behave exactly like the shell would resolve `go` if this
# wrapper didn't exist. We do that by removing the wrapper's own directory
# from $PATH and running `command -v go` against the scrubbed PATH — same
# precedence rules as a normal lookup, skip-self only.
# $LOCAL_REAL_GO still takes precedence as an explicit override.

PATCHER="${LOCAL_GO_PATCHER:-}"
GCFLAGS="${LOCAL_GO_GCFLAGS:-}"
NO_REMOTE=0
REMOTE_ENV_NAMES=""

while [ "$#" -gt 0 ]; do
	case "$1" in
		--no-remote)
			NO_REMOTE=1
			shift
			;;
		--remote-env)
			if [ "$#" -lt 2 ]; then
				printf 'go wrapper: --remote-env requires NAME=VALUE\n' >&2
				exit 2
			fi
			remote_assignment=$2
			remote_name=${remote_assignment%%=*}
			remote_value=${remote_assignment#*=}
			if [ "$remote_name" = "$remote_assignment" ]; then
				printf 'go wrapper: --remote-env requires NAME=VALUE\n' >&2
				exit 2
			fi
			case "$remote_name" in
				''|[0-9]*|*[!A-Za-z0-9_]*)
					printf 'go wrapper: invalid --remote-env name\n' >&2
					exit 2
				;;
		esac
			if ! export "GO_REMOTE_ENV_VALUE_$remote_name=$remote_value"; then
				printf 'go wrapper: unable to store --remote-env value\n' >&2
				exit 2
			fi
			if [ -z "$REMOTE_ENV_NAMES" ]; then
				REMOTE_ENV_NAMES=$remote_name
			else
				REMOTE_ENV_NAMES="$REMOTE_ENV_NAMES $remote_name"
			fi
			shift 2
			;;
		*) break ;;
	esac
done

# Canonicalise the wrapper's own directory once so the PATH scrubbing below
# matches whether $PATH lists a symlink or the real path.
WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd -P)"

scrub_self_from_path() {
	# Echo $PATH minus any entry that resolves to $WRAPPER_DIR.
	OLD_IFS="$IFS"
	IFS=:
	out=""
	for dir in $PATH; do
		[ -z "$dir" ] && continue
		resolved="$(cd "$dir" 2>/dev/null && pwd -P)" || resolved="$dir"
		[ "$resolved" = "$WRAPPER_DIR" ] && continue
		if [ -z "$out" ]; then
			out="$dir"
		else
			out="$out:$dir"
		fi
	done
	IFS="$OLD_IFS"
	printf '%s\n' "$out"
}

find_real_go() {
	if [ -n "${LOCAL_REAL_GO:-}" ] && [ -x "$LOCAL_REAL_GO" ]; then
		printf '%s\n' "$LOCAL_REAL_GO"
		return 0
	fi
	PATH="$(scrub_self_from_path)" command -v go 2>/dev/null
}

command_directory() {
	directory="$PWD"
	case "${1:-}" in
		-C)
			[ -n "${2:-}" ] || return 1
			directory=$2
			;;
		-C=*) directory=${1#-C=} ;;
	esac
	(cd "$directory" 2>/dev/null && pwd -P)
}

find_go_mod() {
	directory=$1
	while :; do
		if [ -f "$directory/go.mod" ]; then
			printf '%s\n' "$directory/go.mod"
			return 0
		fi
		parent=${directory%/*}
		[ -n "$parent" ] || parent=/
		[ "$parent" != "$directory" ] || return 1
		directory=$parent
	done
}

cached_toolchains() {
	go_environment=$(GOTOOLCHAIN=local "$REAL_GO" env GOMODCACHE GOHOSTOS GOHOSTARCH GOVERSION 2>/dev/null) || return 0
	OLD_IFS="$IFS"
	IFS='
'
	set -- $go_environment
	IFS="$OLD_IFS"
	[ "$#" = 4 ] || return 0
	module_cache=$1
	host_os=$2
	host_arch=$3
	bundled_version=${4#go}
	printf '%s ' "$bundled_version"

	# Downloaded toolchains use v0.0.1-goVERSION.GOOS-GOARCH module directories.
	toolchain_prefix=$module_cache/golang.org/toolchain@v0.0.1-go
	toolchain_suffix=.$host_os-$host_arch
	for directory in "$toolchain_prefix"*"$toolchain_suffix"; do
		[ -x "$directory/bin/go" ] || continue
		version=${directory#"$toolchain_prefix"}
		version=${version%"$toolchain_suffix"}
		printf '%s ' "$version"
	done
	printf '\n'
}

select_toolchain() {
	go_mod=$1
	go_version=$(awk '$1 == "go" { print $2; exit }' "$go_mod")
	[ -n "$go_version" ] || return 1
	toolchain_version=$(awk '$1 == "toolchain" { print $2; exit }' "$go_mod")
	candidates=$(cached_toolchains)

	awk -v go_version="$go_version" -v toolchain_version="$toolchain_version" -v candidates="$candidates" '
		function score(version, parts, count) {
			sub(/^go/, "", version)
			count = split(version, parts, ".")
			if (count < 2 || count > 3) return -1
			if (parts[1] !~ /^[0-9]+$/ || parts[2] !~ /^[0-9]+$/) return -1
			if (count == 2) parts[3] = 0
			if (parts[3] !~ /^[0-9]+$/) return -1
			return parts[1] * 1000000 + parts[2] * 1000 + parts[3]
		}
		BEGIN {
			required = score(go_version)
			if (required < 0) exit 1
			required_version = go_version
			if (toolchain_version != "" && toolchain_version != "default") {
				toolchain_required = score(toolchain_version)
				if (toolchain_required > required) {
					required = toolchain_required
					required_version = toolchain_version
				}
			}
			sub(/^go/, "", required_version)
			required_count = split(required_version, required_parts, ".")
			required_family = required_parts[1] "." required_parts[2]
			count = split(candidates, values, /[[:space:]]+/)
			best_score = -1
			for (i = 1; i <= count; i++) {
				candidate_score = score(values[i])
				if (candidate_score < 0) continue
				split(values[i], candidate_parts, ".")
				candidate_family = candidate_parts[1] "." candidate_parts[2]
				if (candidate_family == required_family && candidate_score >= required && candidate_score > best_score) {
					best_score = candidate_score
					best = values[i]
				}
			}
			if (best_score >= 0) {
				print "go" best "+auto"
				exit
			}
			if (required_count == 2 && required_parts[2] >= 21) required_version = required_version ".0"
			print "go" required_version "+auto"
		}
	'
}

prepare_go() {
	REAL_GO="$(find_real_go)"
	if [ -z "$REAL_GO" ]; then
		echo "go wrapper: real go not found. Set LOCAL_REAL_GO=/path/to/go or install go on PATH." >&2
		exit 127
	fi

	if [ -z "${GOTOOLCHAIN:-}" ]; then
		COMMAND_DIRECTORY=$(command_directory "$@") || COMMAND_DIRECTORY=""
		if [ -n "$COMMAND_DIRECTORY" ]; then
			GO_MOD=$(find_go_mod "$COMMAND_DIRECTORY") || GO_MOD=""
			if [ -n "$GO_MOD" ]; then
				GOTOOLCHAIN=$(select_toolchain "$GO_MOD") || GOTOOLCHAIN=""
				[ -z "$GOTOOLCHAIN" ] || export GOTOOLCHAIN
			fi
		fi
	fi
}

log() {
	if [ -n "${GOTOOLCHAIN:-}" ]; then
		printf 'go wrapper execute "GOTOOLCHAIN=%s %s"\n' "$GOTOOLCHAIN" "$*" >&2
	else
		printf 'go wrapper execute "%s"\n' "$*" >&2
	fi
}

remote_failure() {
	printf '%s\n' "[Error] go remote test: If agent reading this, there are some issue with remote execution, DO NOT ATTEMPT to run test on local, instead ask user to confirm then run with --no-remote instead, error: $1" >&2
}

cleanup_remote_error_file() {
	if [ -n "${REMOTE_ERROR_FILE:-}" ]; then
		rm -f -- "$REMOTE_ERROR_FILE"
		REMOTE_ERROR_FILE=""
	fi
}

invoke_remote_test() {
	printf '%s\n' 'go-remote-test terminated without reporting an outcome' > "$REMOTE_ERROR_FILE"
	GO_REMOTE_ERROR_FILE="$REMOTE_ERROR_FILE" go-remote-test "$@"
}

invoke_remote_probe() {
	set -- "$1"
	for remote_name in $REMOTE_ENV_NAMES; do
		set -- --remote-env-name "$remote_name" "$@"
	done
	invoke_remote_test probe "$@"
}

invoke_remote_run() {
	remote_path=$1
	shift
	set -- "$remote_path" -- "$@"
	for remote_name in $REMOTE_ENV_NAMES; do
		set -- --remote-env-name "$remote_name" "$@"
	done
	invoke_remote_test run "$@"
}

clear_remote_env_transport() {
	for remote_name in $REMOTE_ENV_NAMES; do
		unset "GO_REMOTE_ENV_VALUE_$remote_name"
	done
}

if [ "${1:-}" = "test" ]; then
	shift

	if [ "$NO_REMOTE" = "0" ]; then
		if ! command -v go-remote-test >/dev/null 2>&1; then
			remote_failure 'go-remote-test command is unavailable'
			exit 2
		fi
		REMOTE_ERROR_FILE=$(mktemp "${TMPDIR:-/tmp}/go-remote-test.XXXXXXXX") || {
			remote_failure 'unable to create remote execution status file'
			exit 2
		}
		trap cleanup_remote_error_file EXIT HUP INT TERM

		invoke_remote_probe "$PWD"
		remote_status=$?
		if [ -s "$REMOTE_ERROR_FILE" ]; then
			remote_error=$(cat -- "$REMOTE_ERROR_FILE")
			remote_failure "$remote_error"
			cleanup_remote_error_file
			trap - EXIT HUP INT TERM
			exit 2
		fi
		case "$remote_status" in
			0)
				invoke_remote_run "$PWD" "$@"
				remote_status=$?
				if [ -s "$REMOTE_ERROR_FILE" ]; then
					remote_error=$(cat -- "$REMOTE_ERROR_FILE")
					remote_failure "$remote_error"
					[ "$remote_status" != 0 ] || remote_status=1
				fi
				cleanup_remote_error_file
				trap - EXIT HUP INT TERM
				exit "$remote_status"
				;;
			1)
				cleanup_remote_error_file
				trap - EXIT HUP INT TERM
				;;
			*)
				remote_failure "go-remote-test probe failed with exit status $remote_status"
				cleanup_remote_error_file
				trap - EXIT HUP INT TERM
				exit "$remote_status"
				;;
			esac
	fi
	clear_remote_env_transport
	prepare_go test "$@"

	# Detect existing flags to avoid double-injection.
	have_toolexec=0
	have_gcflags=0
	for arg in "$@"; do
		case "$arg" in
			-toolexec=*|--toolexec=*) have_toolexec=1 ;;
			-gcflags=*|--gcflags=*)   have_gcflags=1 ;;
		esac
	done

	set -- "$@"
	# Inject only when (a) the user didn't already pass the flag AND
	# (b) the override isn't an explicit empty string (which means "off").
	[ "$have_toolexec" = "0" ] && [ -n "$PATCHER" ] && set -- "-toolexec=$PATCHER" "$@"
	[ "$have_gcflags"  = "0" ] && [ -n "$GCFLAGS" ] && set -- "-gcflags=$GCFLAGS"  "$@"

	log "GOWORK=off $REAL_GO test $*"
	exec env GOWORK=off "$REAL_GO" test "$@"
fi

clear_remote_env_transport
prepare_go "$@"
log "$REAL_GO $*"
exec "$REAL_GO" "$@"
